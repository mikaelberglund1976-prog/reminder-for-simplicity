# ============================================
# Reminder for Simplicity – Miljövariabler
# Kopiera denna fil till .env.local och fyll i värdena
# ============================================

# Databas (Supabase)
# Hämta från: https://app.supabase.com → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Direct (non-pooled) connection – krävs av Prisma för migrations. Hämta samma ställe, välj "Direct connection".
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# NextAuth
# Generera med: openssl rand -base64 32
NEXTAUTH_SECRET="din-superhemliga-nyckel-här"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (för "Logga in med Google")
# Skapa i https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="din-google-client-id"
GOOGLE_CLIENT_SECRET="din-google-client-secret"

# Resend (Email)
# Skapa konto: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@dindomän.se"

# Admin
# Email-adressen som får åtkomst till /admin och kan trigga cron manuellt
ADMIN_EMAIL="mikaelberglund1976@gmail.com"
# Skyddar /api/cron/send-reminders mot obehörig åtkomst
CRON_SECRET="en-slumpmässig-hemlig-text"

# App-inställningar
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Reminder for Simplicity"
