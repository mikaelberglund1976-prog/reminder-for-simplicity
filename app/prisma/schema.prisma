// Prisma Schema – Reminder for Simplicity
// Database: PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String?
  name              String?
  emailVerified     DateTime?
  phone             String?
  preferredCurrency String?    @default("SEK")
  timezone          String?    @default("Europe/Stockholm")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  isChildProfile    Boolean    @default(false)

  reminders         Reminder[]
  accounts          Account[]
  sessions          Session[]
  householdMembers  HouseholdMember[]
  assignedReminders Reminder[]  @relation("AssignedReminders")
  fallbackReminders Reminder[]  @relation("FallbackReminders")
  handoverReminders Reminder[]  @relation("HandoverReminders")
  passwordResetTokens PasswordResetToken[]
  shoppingListItemsAdded     ShoppingListItem[] @relation("ShoppingListAdded")
  shoppingListItemsPurchased ShoppingListItem[] @relation("ShoppingListPurchased")
  wishlistItemsOwned    WishlistItem[] @relation("WishlistOwner")
  wishlistItemsAdded    WishlistItem[] @relation("WishlistAdded")
  wishlistItemsReserved WishlistItem[] @relation("WishlistReserved")
  wishlistItemsPurchased WishlistItem[] @relation("WishlistPurchased")

  @@map("users")
}

model ShoppingListItem {
  id           String    @id @default(cuid())
  householdId  String
  name         String
  quantity     String?
  category     ShoppingCategory @default(UNSORTED)
  isPurchased  Boolean   @default(false)
  addedBy      String
  purchasedBy  String?
  purchasedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  adder        User      @relation("ShoppingListAdded", fields: [addedBy], references: [id], onDelete: Cascade)
  purchaser    User?     @relation("ShoppingListPurchased", fields: [purchasedBy], references: [id], onDelete: SetNull)

  @@map("shopping_list_items")
}

// Remembers which category a household chose the last time a given item
// name was added, so recurring items (e.g. "milk") auto-sort correctly
// next time without the user having to re-categorize it. See PRODUCT_SPEC 4b.8.
model ShoppingCategoryMemory {
  id          String           @id @default(cuid())
  householdId String
  itemName    String           // stored lowercase/trimmed, matched case-insensitively
  category    ShoppingCategory
  updatedAt   DateTime         @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, itemName])
  @@map("shopping_category_memory")
}

// A child's personal wish list. Purchase/reservation status is intentionally
// visible only to adults — see PRODUCT_SPEC 4b.9 and P0.6/P0.7 in the order.
// API routes must strip status/reservedBy/purchasedBy from any response
// served to the owning child; never rely on the UI alone to hide it.
model WishlistItem {
  id           String         @id @default(cuid())
  householdId  String
  childId      String         // the child this wish belongs to
  addedBy      String         // usually the same as childId; kept separate in case an adult adds on the child's behalf later
  name         String
  url          String?
  price        Float?
  currency     String?        @default("SEK")
  imageUrl     String?
  note         String?
  status       WishlistStatus @default(WANTED)
  reservedBy   String?
  reservedAt   DateTime?
  purchasedBy  String?
  purchasedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  household    Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child        User           @relation("WishlistOwner", fields: [childId], references: [id], onDelete: Cascade)
  adder        User           @relation("WishlistAdded", fields: [addedBy], references: [id], onDelete: Cascade)
  reserver     User?          @relation("WishlistReserved", fields: [reservedBy], references: [id], onDelete: SetNull)
  purchaser    User?          @relation("WishlistPurchased", fields: [purchasedBy], references: [id], onDelete: SetNull)

  @@map("wishlist_items")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Reminder {
  id                  String           @id @default(cuid())
  userId              String
  householdId         String?
  name                String
  category            ReminderCategory @default(OTHER)
  date                DateTime
  recurrence          Recurrence       @default(ONCE)
  amount              Float?
  currency            String?          @default("SEK")
  note                String?
  reminderDaysBefore  Int              @default(3)
  isActive            Boolean          @default(true)
  lastSentAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Pro fields
  assignedTo          String?
  fallbackTo          String?
  visibility          Visibility       @default(PRIVATE)
  handoverState       HandoverState    @default(NONE)
  handoverTo          String?
  handoverInitiatedAt DateTime?
  urgencyLevel        UrgencyLevel     @default(STANDARD)

  // Family chore fields
  requiresApproval    Boolean          @default(false)
  choreRecurrenceDays String?          // e.g. "1,2,3,4,5" = Mon–Fri; null = uses recurrence field

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  household           Household?       @relation(fields: [householdId], references: [id])
  assignedUser        User?            @relation("AssignedReminders", fields: [assignedTo], references: [id], onDelete: SetNull)
  fallbackUser        User?            @relation("FallbackReminders", fields: [fallbackTo], references: [id], onDelete: SetNull)
  handoverUser        User?            @relation("HandoverReminders", fields: [handoverTo], references: [id], onDelete: SetNull)
  logs                ReminderLog[]
  completions         ChoreCompletion[]

  @@map("reminders")
}

model ChoreCompletion {
  id           String      @id @default(cuid())
  reminderId   String
  childId      String      // userId of who completed it
  weekStart    DateTime    // Monday 00:00 UTC of the relevant week
  status       ChoreStatus @default(DONE)
  approvedBy   String?     // userId of approving adult
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())

  reminder     Reminder    @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, childId, weekStart])
  @@map("chore_completions")
}

model FamilyTrial {
  id          String    @id @default(cuid())
  householdId String    @unique
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  childId     String    // userId of the 1 trial child
  createdBy   String    // userId of the adult who started it

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("family_trials")
}

model ReminderLog {
  id          String   @id @default(cuid())
  reminderId  String
  sentAt      DateTime @default(now())
  type        String   @default("email")

  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@map("reminder_logs")
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Household {
  id        String   @id @default(cuid())
  name      String?
  is_pro    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional public share link for the shopping list (e.g. a relative or
  // babysitter who isn't a household member) — see shopping-list share
  // feature. Null/absent means sharing is off. Anyone with the token can
  // view and edit the list, no login required; rotate to revoke access.
  shoppingListShareToken String? @unique

  members     HouseholdMember[]
  reminders   Reminder[]
  invites     HouseholdInvite[]
  familyTrial FamilyTrial?
  shoppingListItems ShoppingListItem[]
  shoppingCategoryMemory ShoppingCategoryMemory[]
  wishlistItems WishlistItem[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String        @id @default(cuid())
  householdId String
  email       String
  token       String        @unique @default(cuid())
  role        HouseholdRole @default(ADULT)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_invites")
}

enum HouseholdRole {
  OWNER
  PARENT
  ADULT
  CHILD
  MEMBER
}

enum ReminderCategory {
  SUBSCRIPTION
  BIRTHDAY
  INSURANCE
  CONTRACT
  HEALTH
  BILL
  CHORE
  OTHER
}

enum Recurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum Visibility {
  PRIVATE
  HOUSEHOLD
  PARENTS
}

enum HandoverState {
  NONE
  PENDING
  ACCEPTED
}

enum UrgencyLevel {
  STANDARD
  HIGH
  CRITICAL
}

enum ChoreStatus {
  DONE
  PENDING_APPROVAL
  APPROVED
}

// Store-aisle categories for the shared shopping list (P0.2 in the order).
enum ShoppingCategory {
  PRODUCE     // Fruit & vegetables
  DAIRY
  BREAD
  FROZEN
  PANTRY
  HOUSEHOLD
  MEAT_FISH
  OTHER
  UNSORTED
}

enum WishlistStatus {
  WANTED
  RESERVED
  PURCHASED
}
