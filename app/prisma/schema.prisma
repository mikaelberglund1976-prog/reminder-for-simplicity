// Prisma Schema – Reminder for Simplicity
// Database: PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String?
  // Optional 4-digit PIN (hashed), separate from `password` — lets an adult
  // keep their real email+password login AND opt into quick PIN login on a
  // shared family device, without weakening their main credential. Child
  // profiles don't use this field; their PIN is still stored in `password`
  // (see child-profiles route) since it's their only credential.
  pin               String?
  name              String?
  emailVerified     DateTime?
  phone             String?
  preferredCurrency String?    @default("SEK")
  timezone          String?    @default("Europe/Stockholm")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  isChildProfile    Boolean    @default(false)

  // 2026-07-28: admin approval gate for new signups. Defaults to true so
  // this column backfills as "approved" for every account that already
  // exists (nobody currently in the DB gets locked out retroactively).
  // New top-level signups (email/password register + first-time Google
  // sign-in) explicitly pass `approved: false` at creation — see
  // /api/auth/register and the Google branch of the signIn callback in
  // auth.ts. Child profiles and household-invite joins are NOT gated
  // (they inherit trust from the already-approved parent/inviter who
  // created them), so they're left on the true default deliberately.
  approved          Boolean    @default(true)
  approvedAt        DateTime?

  // 2026-07-28: secret token for the user's personal outbound calendar feed
  // (see /api/calendar/feed/[token]) — lets them subscribe to "everything
  // assigned to or visible to me" from their own Google/Outlook/Apple
  // calendar app via "Add calendar > From URL". Same trust model as
  // Household.shoppingListShareToken / List.shareToken: the token itself is
  // the auth, no login required to read the feed, rotate to revoke. Null
  // until the user first requests their feed URL (lazy-generated).
  calendarFeedToken String?    @unique

  reminders         Reminder[]
  accounts          Account[]
  sessions          Session[]
  householdMembers  HouseholdMember[]
  assignedReminders Reminder[]  @relation("AssignedReminders")
  fallbackReminders Reminder[]  @relation("FallbackReminders")
  handoverReminders Reminder[]  @relation("HandoverReminders")
  passwordResetTokens PasswordResetToken[]
  shoppingListItemsAdded     ShoppingListItem[] @relation("ShoppingListAdded")
  shoppingListItemsPurchased ShoppingListItem[] @relation("ShoppingListPurchased")
  wishlistItemsOwned    WishlistItem[] @relation("WishlistOwner")
  wishlistItemsAdded    WishlistItem[] @relation("WishlistAdded")
  wishlistItemsReserved WishlistItem[] @relation("WishlistReserved")
  wishlistItemsPurchased WishlistItem[] @relation("WishlistPurchased")
  listsOwned    List[] @relation("ListOwner")
  listsCreated  List[] @relation("ListCreated")
  listMemberships ListMember[]
  suggestions      Suggestion[]
  suggestionVotes  SuggestionVote[]

  @@map("users")
}

model ShoppingListItem {
  id           String    @id @default(cuid())
  householdId  String
  // 2026-07-27: which List (kind SHOPPING) this item belongs to, now that a
  // household can have more than one shopping list. Nullable only so the
  // additive migration doesn't fail on existing rows — backfill-lists.js
  // fills it in, and app code always sets it on create.
  listId       String?
  name         String
  quantity     String?
  note         String?
  url          String?
  imageUrl     String?
  // Deprecated 2026-07-27: replaced by categoryId/categoryDef below, which
  // supports per-household custom categories. Left in place (unused by app
  // code) so the household-scoped backfill script has a source column to
  // read from — see scripts/backfill-shopping-categories.ts. Safe to drop
  // in a later migration once every household has been backfilled.
  category     ShoppingCategory @default(UNSORTED)
  categoryId   String?
  isPurchased  Boolean   @default(false)
  addedBy      String
  purchasedBy  String?
  purchasedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  list         List?     @relation(fields: [listId], references: [id], onDelete: Cascade)
  adder        User      @relation("ShoppingListAdded", fields: [addedBy], references: [id], onDelete: Cascade)
  purchaser    User?     @relation("ShoppingListPurchased", fields: [purchasedBy], references: [id], onDelete: SetNull)
  categoryDef  ShoppingCategoryDef? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("shopping_list_items")
}

// Remembers which category a household chose the last time a given item
// name was added, so recurring items (e.g. "milk") auto-sort correctly
// next time without the user having to re-categorize it. See PRODUCT_SPEC 4b.8.
model ShoppingCategoryMemory {
  id          String           @id @default(cuid())
  householdId String
  itemName    String           // stored lowercase/trimmed, matched case-insensitively
  // Deprecated 2026-07-27 — see ShoppingListItem.category comment above.
  category    ShoppingCategory
  categoryId  String?
  updatedAt   DateTime         @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoryDef ShoppingCategoryDef? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([householdId, itemName])
  @@map("shopping_category_memory")
}

// Household-editable aisle categories for the shopping list — replaces the
// fixed ShoppingCategory enum (2026-07-27) so households can add a missing
// category and rename existing ones. `slug` identifies the 8 built-in
// defaults ("produce", "dairy", ...) so keyword auto-categorization keeps
// working even after a household renames one; custom categories a household
// adds themselves have slug = null. There's no "Unsorted" row — an item with
// categoryId = null is simply uncategorized and shown in an Unsorted group.
model ShoppingCategoryDef {
  id          String   @id @default(cuid())
  householdId String
  slug        String?
  label       String
  icon        String   @default("📦")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       ShoppingListItem[]
  memory      ShoppingCategoryMemory[]

  @@unique([householdId, slug])
  @@map("shopping_category_defs")
}

// A child's personal wish list. Purchase/reservation status is intentionally
// visible only to adults — see PRODUCT_SPEC 4b.9 and P0.6/P0.7 in the order.
// API routes must strip status/reservedBy/purchasedBy from any response
// served to the owning child; never rely on the UI alone to hide it.
model WishlistItem {
  id           String         @id @default(cuid())
  householdId  String
  childId      String         // the child this wish belongs to
  // 2026-07-27: which List (kind WISHLIST) this item belongs to, now that a
  // child can have more than one wishlist (e.g. "Birthday", "Christmas").
  // Nullable for the same additive-migration reason as ShoppingListItem.listId.
  listId       String?
  addedBy      String         // usually the same as childId; kept separate in case an adult adds on the child's behalf later
  name         String
  url          String?
  price        Float?
  currency     String?        @default("SEK")
  imageUrl     String?
  note         String?
  status       WishlistStatus @default(WANTED)
  reservedBy   String?
  reservedAt   DateTime?
  purchasedBy  String?
  purchasedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  household    Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  list         List?          @relation(fields: [listId], references: [id], onDelete: Cascade)
  child        User           @relation("WishlistOwner", fields: [childId], references: [id], onDelete: Cascade)
  adder        User           @relation("WishlistAdded", fields: [addedBy], references: [id], onDelete: Cascade)
  reserver     User?          @relation("WishlistReserved", fields: [reservedBy], references: [id], onDelete: SetNull)
  purchaser    User?          @relation("WishlistPurchased", fields: [purchasedBy], references: [id], onDelete: SetNull)

  @@map("wishlist_items")
}

// 2026-07-27: generalized "a named list a household can share with everyone
// or just some members" — powers both multiple shopping lists (kind
// SHOPPING, ownerId null) and multiple per-child wishlists (kind WISHLIST,
// ownerId = the child). Who can see a list:
//   - the list's owner (a child always sees their own wishlists), or
//   - the list's creator, or
//   - an OWNER/PARENT household member (parental oversight), or
//   - visibleToAll = true, or
//   - an explicit ListMember row.
// Only OWNER/PARENT can change visibleToAll/members — see lib/lists.ts.
model List {
  id           String   @id @default(cuid())
  householdId  String
  kind         ListKind
  name         String
  ownerId      String?  // WISHLIST only: the child this list belongs to
  visibleToAll Boolean  @default(true)
  shareToken   String?  @unique // public no-login link, SHOPPING lists only
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner         User?     @relation("ListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  creator       User      @relation("ListCreated", fields: [createdBy], references: [id], onDelete: Cascade)
  members       ListMember[]
  shoppingItems ShoppingListItem[]
  wishlistItems WishlistItem[]

  @@map("lists")
}

model ListMember {
  id     String @id @default(cuid())
  listId String
  userId String

  list   List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@map("list_members")
}

enum ListKind {
  SHOPPING
  WISHLIST
}

// 2026-07-28: cross-customer feedback board ("Ideas & voting" / Förbättringsförslag
// & Nya funktioner). Deliberately NOT household-scoped — every logged-in customer,
// across every household, sees and votes on the same shared list, matching the
// "public roadmap" pattern used by Tribe Family and Family Folder (see
// MARKET_RESEARCH_EU.md). Requires login (no anonymous/public access in v1).
model Suggestion {
  id          String             @id @default(cuid())
  userId      String             // author
  title       String
  description String?
  category    SuggestionCategory @default(NEW_FEATURE)
  status      SuggestionStatus   @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes SuggestionVote[]

  @@map("suggestions")
}

// One row per (suggestion, user) — a user can upvote a given suggestion once.
// Voting again removes the vote (toggle), same interaction as most public
// feedback boards (Canny, GitHub reactions).
model SuggestionVote {
  id           String   @id @default(cuid())
  suggestionId String
  userId       String
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@map("suggestion_votes")
}

enum SuggestionCategory {
  IMPROVEMENT  // tweak to something that already exists
  NEW_FEATURE  // something that doesn't exist yet
}

enum SuggestionStatus {
  OPEN         // default — awaiting triage
  PLANNED      // we intend to build this
  IN_PROGRESS  // actively being built
  DONE         // shipped
  DECLINED     // not going to build this, with reason in description/reply
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Reminder {
  id                  String           @id @default(cuid())
  userId              String
  householdId         String?
  name                String
  category            ReminderCategory @default(OTHER)
  date                DateTime
  recurrence          Recurrence       @default(ONCE)
  amount              Float?
  currency            String?          @default("SEK")
  note                String?
  reminderDaysBefore  Int              @default(3)
  isActive            Boolean          @default(true)
  lastSentAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Pro fields
  assignedTo          String?
  fallbackTo          String?
  visibility          Visibility       @default(PRIVATE)
  handoverState       HandoverState    @default(NONE)
  handoverTo          String?
  handoverInitiatedAt DateTime?
  urgencyLevel        UrgencyLevel     @default(STANDARD)

  // Family chore fields
  requiresApproval    Boolean          @default(false)
  choreRecurrenceDays String?          // e.g. "1,2,3,4,5" = Mon–Fri; null = uses recurrence field

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  household           Household?       @relation(fields: [householdId], references: [id])
  assignedUser        User?            @relation("AssignedReminders", fields: [assignedTo], references: [id], onDelete: SetNull)
  fallbackUser        User?            @relation("FallbackReminders", fields: [fallbackTo], references: [id], onDelete: SetNull)
  handoverUser        User?            @relation("HandoverReminders", fields: [handoverTo], references: [id], onDelete: SetNull)
  logs                ReminderLog[]
  completions         ChoreCompletion[]

  @@map("reminders")
}

model ChoreCompletion {
  id           String      @id @default(cuid())
  reminderId   String
  childId      String      // userId of who completed it
  weekStart    DateTime    // Monday 00:00 UTC of the relevant week
  status       ChoreStatus @default(DONE)
  approvedBy   String?     // userId of approving adult
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())

  reminder     Reminder    @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, childId, weekStart])
  @@map("chore_completions")
}

model FamilyTrial {
  id          String    @id @default(cuid())
  householdId String    @unique
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  childId     String    // userId of the 1 trial child
  createdBy   String    // userId of the adult who started it

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("family_trials")
}

model ReminderLog {
  id          String   @id @default(cuid())
  reminderId  String
  sentAt      DateTime @default(now())
  type        String   @default("email")

  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@map("reminder_logs")
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Household {
  id        String   @id @default(cuid())
  name      String?
  is_pro    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional public share link for the shopping list (e.g. a relative or
  // babysitter who isn't a household member) — see shopping-list share
  // feature. Null/absent means sharing is off. Anyone with the token can
  // view and edit the list, no login required; rotate to revoke access.
  shoppingListShareToken String? @unique

  members     HouseholdMember[]
  reminders   Reminder[]
  invites     HouseholdInvite[]
  familyTrial FamilyTrial?
  shoppingListItems ShoppingListItem[]
  shoppingCategoryMemory ShoppingCategoryMemory[]
  shoppingCategoryDefs ShoppingCategoryDef[]
  wishlistItems WishlistItem[]
  lists List[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String        @id @default(cuid())
  householdId String
  email       String
  token       String        @unique @default(cuid())
  role        HouseholdRole @default(ADULT)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_invites")
}

enum HouseholdRole {
  OWNER
  PARENT
  ADULT
  CHILD
  MEMBER
}

enum ReminderCategory {
  SUBSCRIPTION
  BIRTHDAY
  INSURANCE
  CONTRACT
  HEALTH
  BILL
  CHORE
  // 2026-07-28: recurring booking assigned to a child (e.g. "Karate, Tuesdays") —
  // same Reminder fields as CHORE (assignedTo/choreRecurrenceDays) but no
  // completion/approval workflow. Created via /api/family/chores?category=TRAINING,
  // deliberately excluded from the general /api/reminders list (see that route),
  // same treatment as CHORE. Can also be populated by subscribing to an
  // external club/school .ics feed — see CalendarSubscription (not yet built).
  TRAINING
  // 2026-07-28: tests/homework. Same Reminder fields as CHORE/TRAINING
  // (assignedTo, no completion/approval). Deliberately its OWN section, not
  // folded into general Reminders — corrected after initial mis-scoping;
  // Mikael's requirement is a dedicated School area where children can add
  // their own tests/homework and only ever see their own (see the isChild
  // filter in /api/family/chores GET). Created via
  // /api/family/chores?category=SCHOOL, excluded from /api/reminders (see
  // that route's notIn filter), adult overview at /dashboard/school,
  // child self-service at /dashboard/family/child.
  SCHOOL
  OTHER
}

enum Recurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum Visibility {
  PRIVATE
  HOUSEHOLD
  PARENTS
}

enum HandoverState {
  NONE
  PENDING
  ACCEPTED
}

enum UrgencyLevel {
  STANDARD
  HIGH
  CRITICAL
}

enum ChoreStatus {
  DONE
  PENDING_APPROVAL
  APPROVED
}

// Store-aisle categories for the shared shopping list (P0.2 in the order).
enum ShoppingCategory {
  PRODUCE     // Fruit & vegetables
  DAIRY
  BREAD
  FROZEN
  PANTRY
  HOUSEHOLD
  MEAT_FISH
  OTHER
  UNSORTED
}

enum WishlistStatus {
  WANTED
  RESERVED
  PURCHASED
}
